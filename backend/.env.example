FLASK_ENV=development

# Yerel geliştirme için boş bırakılabilir (app/config.py içindeki zayıf
# varsayılanlar kullanılır). ÜRETİMDE mutlaka güçlü, rastgele değerler
# atayın, aksi halde uygulama başlamayı reddeder (bkz. app/__init__.py):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

DATABASE_URL=postgresql+psycopg://mindarena:mindarena@localhost:5432/mindarena
CORS_ORIGINS=http://localhost:5173

# Şifremi unuttum e-postası. Boşsa bağlantı gönderilmez.
# Ücretsiz Brevo: SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587
# SMTP_USER ve SMTP_PASSWORD Brevo SMTP anahtarıdır. SMTP_FROM doğrulanmış gönderen.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
